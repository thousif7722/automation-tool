{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@insta-automation/types": ["../../packages/types/dist/index.d.ts"],
      "@insta-automation/utils": ["../../packages/utils/dist/index.d.ts"],
      "@insta-automation/config": ["../../packages/config/dist/index.d.ts"],
      "@insta-automation/validation": ["../../packages/validation/dist/index.d.ts"],
      "@insta-automation/database": ["../../packages/database/dist/index.d.ts"],
      "@insta-automation/auth": ["../../packages/auth/dist/index.d.ts"],
      "@insta-automation/permissions": ["../../packages/permissions/dist/index.d.ts"],
      "@insta-automation/audit": ["../../packages/audit/dist/index.d.ts"],
      "@insta-automation/events": ["../../packages/events/dist/index.d.ts"],
      "@insta-automation/instagram": ["../../packages/instagram/dist/index.d.ts"],
      "@insta-automation/queue": ["../../packages/queue/dist/index.d.ts"],
      "@insta-automation/workflows": ["../../packages/workflows/dist/index.d.ts"],
      "@insta-automation/ai": ["../../packages/ai/dist/index.d.ts"],
      "@insta-automation/billing": ["../../packages/billing/dist/index.d.ts"],
      "@insta-automation/webhook-worker": ["../../services/webhook-worker/dist/index.d.ts"],
      "@insta-automation/automation-worker": ["../../services/automation-worker/dist/index.d.ts"],
      "@insta-automation/scheduler": ["../../services/scheduler/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
