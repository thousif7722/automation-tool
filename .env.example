# Instagram Automation OS Environment Variables - Example

# Core Services
PORT=4000
NODE_ENV=production
API_URL=https://YOUR_DOMAIN.com
WEB_URL=https://app.YOUR_DOMAIN.com
ADMIN_URL=https://admin.YOUR_DOMAIN.com
LANDING_URL=https://YOUR_DOMAIN.com

# Databases
MONGODB_URI=mongodb://localhost:27017/insta_automation
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Keys (Min 32 characters)
JWT_SECRET=replace_with_secure_random_32_character_string_for_jwt!
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_secure_random_32_character_token_key!

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Meta / Instagram Graph API Configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=generate_a_secure_verify_token
META_REDIRECT_URI=https://YOUR_DOMAIN.com/api/instagram/oauth/callback

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Providers (ollama | bedrock | gemini)
ACTIVE_AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
